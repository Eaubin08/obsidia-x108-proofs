+def is_general_conversation_readonly(
+    user_message: str,
+    authority_snapshot: dict,
+    semantic_query_snapshot: dict,
+) -> bool:
+    """
+    Returns True when user_message is a safe, non-critical conversational message
+    that can receive a natural readonly response without requiring index lookup.
+
+    Does NOT bypass X108. Does NOT open ACT. No write.
+    Routes GENERAL safe requests away from SEMANTIC_MATCH_FAILED_GENERAL.
+
+    Returns False for: action requests, write/mutation signals, non-GENERAL topics.
+    """
+    import re as _re
+
+    topic = (semantic_query_snapshot or {}).get("topic", "GENERAL")
+    if topic not in ("GENERAL", "", None):
+        return False
+
+    request_type = (authority_snapshot or {}).get("request_type", "PURE_RESPONSE")
+    _BLOCKED_TYPES = {"ACTION_OR_ACT_REQUEST", "MEMORY_WRITE_REQUEST", "EXTERNAL_ACCESS_REQUEST"}
+    if request_type in _BLOCKED_TYPES:
+        return False
+
+    msg_lower = (user_message or "").lower()
+
+    _BLOCK_SIGNALS = [
+        "autorise le", "authoriz",
+        "d├®clenche act", "declenche act",
+        "├®cris en m├®moire", "ecris en memoire",
+        "graphiti_write", "neo4j_write",
+        "modifie x108", "modifie le kernel",
+        "supprime les nodes", "supprime les n┼ôuds",
+        "lance le write",
+        "lancer l'├®criture", "lancer l'ecriture",
+        "valide cette action irr├®versible", "valide cette action irreversible",
+        "mutation x108", "kernel_mutation",
+    ]
+    if any(sig in msg_lower for sig in _BLOCK_SIGNALS):
+        return False
+
+    _CONV_PATTERNS = [
+        r"^(bonjour|salut|bonsoir|coucou|hello|hey|hi)\b",
+        r"^(merci|thanks|thank you)\b",
+        r"^(ok nickel|ok\b|nickel|parfait|super|cool|bien|noted|re├ºu|recu|d'accord|daccord|entendu)",
+        r"dis (bonjour|salut|bonsoir)",
+        r"dire (bonjour|salut|bonsoir)",
+        r"on reprend|reprends",
+        r"tu peux r[e├®]pondre",
+        r"r[e├®]ponds simplement|naturellement",
+        r"(explique|ce qu.on vient de|vient de stabiliser|on vient de)",
+    ]
+    for pattern in _CONV_PATTERNS:
+        if _re.search(pattern, msg_lower):
+            return True
+
+    return False
+
+
+def build_general_conversation_answer(
+    user_message: str,
+    runtime_context: dict | None = None,
+    brody_full_context: dict | None = None,
+) -> str:
+    """
+    Build a natural conversational readonly answer for safe GENERAL requests.
+    Never invents state not present in context.
+    Never opens ACT, never writes, never emits verdict.
+    Boundary footer is appended by build_true_brody_answer step 8.
+    """
+    import re as _re
+
+    msg_lower = (user_message or "").lower().strip()
+
+    # ÔöÇÔöÇ "dis bonjour [├á/a] [person]" ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ
+    m = _re.search(r"dis (bonjour|salut|bonsoir) [├áa] (.+)", msg_lower)
+    if m:
+        person = m.group(2).strip().rstrip(".!?")
+        greetings = {"bonjour": "Bonjour", "salut": "Salut", "bonsoir": "Bonsoir"}
+        greeting = greetings.get(m.group(1), "Bonjour")
+        return f"{greeting} {person}."
+
+    # ÔöÇÔöÇ Greeting ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ
+    if _re.search(r"^(bonjour|salut|bonsoir|coucou|hello|hey|hi)\b", msg_lower):
+        return "Bonjour."
+
+    # ÔöÇÔöÇ Thanks ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ
+    if _re.match(r"^(merci|thanks|thank you)", msg_lower):
+        return "Avec plaisir."
+
+    # ÔöÇÔöÇ Acknowledgement ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ
+    if _re.match(r"^(ok nickel|ok\b|nickel|parfait|super|cool|bien|noted|re├ºu|recu|d'accord|daccord|entendu)", msg_lower):
+        return "Parfait."
+
+    # ÔöÇÔöÇ Explain what was just stabilized ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ
+    if _re.search(r"(explique|ce qu.on vient de|vient de stabiliser|on vient de)", msg_lower):
+        return (
+            "On vient de stabiliser une cha├«ne terminal Brody en lecture seule : "
+            "conversation locale, capture de candidats m├®moire, sidecar, "
+            "dry-run, prepare-write, rollback/read-link, sans ├®criture r├®elle par d├®faut."
+        )
+
+    # ÔöÇÔöÇ Where do we resume? ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ
+    if _re.search(r"(on reprend|reprends)", msg_lower):
+        return "Je suis pr├¬t. Dis-moi sur quoi tu veux avancer."
+
+    # ÔöÇÔöÇ Can you respond naturally? ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ
+    if _re.search(r"(tu peux r[e├®]pondre|r[e├®]ponds simplement|naturellement)", msg_lower):
+        return "Oui. Je r├®ponds."
+
+    # ÔöÇÔöÇ Generic conversational fallback ÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇÔöÇ
+    return "Je lis ta demande."
+
