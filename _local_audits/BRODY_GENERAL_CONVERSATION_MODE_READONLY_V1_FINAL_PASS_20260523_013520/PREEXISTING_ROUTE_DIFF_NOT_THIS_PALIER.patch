+def _last_mile_brody_utf8_repair(payload: dict) -> dict:
+    """
+    Last-mile UTF-8 repair on the final HTTP payload dict.
+    Walks all string values and repairs mojibake using:
+      normalize_brody_text → repair_mojibake_via_latin1_roundtrip → normalize_brody_text
+    No ASCII fallback — accents must be preserved if repair succeeds.
+    Applied just before return to catch any corruption introduced
+    during dict serialization or middleware.
+    """
+    if not isinstance(payload, dict):
+        return payload
+    result = {}
+    for key, value in payload.items():
+        if isinstance(value, str):
+            repaired = normalize_brody_text(value)
+            if is_mojibake(repaired):
+                repaired = repair_mojibake_via_latin1_roundtrip(repaired)
+                repaired = normalize_brody_text(repaired)
+            result[key] = repaired
+        elif isinstance(value, dict):
+            result[key] = _last_mile_brody_utf8_repair(value)
+        elif isinstance(value, list):
+            result[key] = [
+                _last_mile_brody_utf8_repair(v) if isinstance(v, dict)
+                else normalize_brody_text(v) if isinstance(v, str)
+                else v
+                for v in value
+            ]
+        else:
+            result[key] = value
+    return result
+
+
+def _compact_brody_payload(payload: dict, *, compact: bool = False, debug: bool = False) -> dict:
+    """
+    Control payload size based on mode flags.
+
+    compact=True  → light payload (core fields only, no deep snapshots)
+    debug=True    → full payload (all snapshots + debug markers)
+    default       → backward-compatible (current behavior)
+    """
+    if debug:
+        return payload  # Full payload with all snapshots
+
+    if compact:
+        # Core fields that must always be present
+        keep = {
+            "response", "final_answer", "response_md",
+            "topic", "final_answer_source",
+            "decision_authority", "emits_act", "emits_verdict",
+            "memory_write", "graphiti_write", "neo4j_write",
+            "kernel_mutation", "readonly", "advisory_only",
+            "language", "timestamp", "source",
+            "graphiti_status", "neo4j_status",
+            "voice_runtime", "action_risk",
+        }
+        compacted = {}
+        for k, v in payload.items():
+            if k in keep:
+                compacted[k] = v
+        # Signal that deep snapshots were omitted
+        compacted["compact_mode"] = True
+        compacted["deep_snapshots_omitted"] = True
+        compacted["deep_snapshots_available"] = True
+        compacted["debug_payload_omitted"] = True
+        compacted["debug_payload_available"] = True
+        compacted["omitted_debug_fields"] = [
+            k for k in payload if k not in keep and not k.startswith("debug_")
+        ]
+        return compacted
+
+    # Default: backward-compatible, strip diagnostic debug markers
+    result = {}
+    for k, v in payload.items():
+        if k.startswith("debug_"):
+            continue  # Strip temporary debug markers
+        result[k] = v
+    return result
+
