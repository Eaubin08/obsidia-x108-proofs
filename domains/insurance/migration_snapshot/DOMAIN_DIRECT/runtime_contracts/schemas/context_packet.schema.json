{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "obsidia/runtime_contracts/context_packet.schema.json",
  "title": "ContextPacket",
  "description": "Contexte readonly depuis périphéries vers X-108. Jamais de décision. Boundary: READONLY_CONTEXT_ONLY / NO_ACT.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "context_id", "source_layer", "source_module",
    "readonly", "advisory_only", "confidence", "claim_scope",
    "labels", "decision_authority", "emits_act", "emits_verdict",
    "source_status", "timestamp_or_tick", "context_payload"
  ],
  "properties": {
    "context_id": {
      "type": "string",
      "format": "uuid",
      "description": "Identifiant unique. Immutable."
    },
    "source_layer": {
      "type": "string",
      "enum": [
        "graphiti", "brody", "npl", "sigma", "atlas", "cognitive",
        "external_signals", "entropy", "rssi", "rgpd", "balance",
        "gps", "agent", "kernel"
      ],
      "description": "Couche source du contexte."
    },
    "source_module": {
      "type": "string",
      "description": "Module précis émetteur."
    },
    "readonly": {
      "type": "boolean",
      "const": true,
      "description": "Toujours true. false → reject."
    },
    "advisory_only": {
      "type": "boolean",
      "const": true,
      "description": "Toujours true."
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "description": "Niveau de confiance [0,1]. 1.0 interdit sauf source_status=LEAN_PROVEN."
    },
    "claim_scope": {
      "type": "string",
      "enum": [
        "CLAIMABLE_FORMAL", "CLAIMABLE_ADVISORY",
        "CLAIMABLE_SPEC_ONLY", "CLAIM_FORBIDDEN", "FUTURE_FORMAL_TARGET_ONLY"
      ]
    },
    "labels": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "description": "Labels de claim-scope obligatoires selon source_layer. Ex: NPL_ADVISORY_NOT_SOVEREIGN, PYTHON_SPEC_NOT_LEAN_PROVEN, EXTERNAL_SIGNAL_ONLY."
    },
    "decision_authority": {
      "type": "string",
      "enum": ["KX108_ONLY"],
      "description": "Toujours KX108_ONLY."
    },
    "emits_act": {
      "type": "boolean",
      "const": false
    },
    "emits_verdict": {
      "type": "boolean",
      "const": false
    },
    "source_status": {
      "type": "string",
      "enum": [
        "LEAN_PROVEN", "PYTHON_TESTED", "PYTHON_SPEC_NOT_LEAN_PROVEN",
        "DOC_ONLY", "FUTURE_FORMAL_TARGET", "SPEC_FUTURE",
        "SOURCE_PARTIAL", "COPIED_READONLY", "AUDITED_ONLY",
        "SPEC_IMPORTED", "SPEC_LOCKED", "SOURCE_ONLY", "UNKNOWN_SOURCE"
      ]
    },
    "timestamp_or_tick": {
      "type": "string",
      "description": "Contexte temporel."
    },
    "context_payload": {
      "type": "object",
      "description": "Contenu du contexte — structure libre typée selon source_layer."
    },
    "p107_advisory": {
      "type": "object",
      "description": "Signal Lyapunov advisory (P107). PYTHON_SPEC_NOT_LEAN_PROVEN.",
      "properties": {
        "L_value": { "type": "number", "minimum": -1.0, "maximum": 1.0 },
        "partition": { "type": "string", "enum": ["X_A", "X_B", "X_H", "X_UNKNOWN"] },
        "label": { "type": "string", "const": "PYTHON_SPEC_NOT_LEAN_PROVEN" },
        "authority": { "type": "string", "const": "ADVISORY_ONLY" }
      },
      "additionalProperties": false
    },
    "p161_advisory": {
      "type": "object",
      "description": "Signal thermo_debt advisory (P161). PYTHON_SPEC_NOT_LEAN_PROVEN.",
      "properties": {
        "thermo_debt": { "type": "number", "minimum": 0.0 },
        "delta_E": { "type": "number" },
        "delta_C": { "type": "number" },
        "label": { "type": "string", "const": "PYTHON_SPEC_NOT_LEAN_PROVEN" },
        "authority": { "type": "string", "const": "ADVISORY_ONLY" }
      },
      "additionalProperties": false
    },
    "external_signal_flags": {
      "type": "object",
      "description": "Signaux External Signals (F04). EXTERNAL_SIGNAL_ONLY.",
      "properties": {
        "anti_replay_check": { "type": "string", "enum": ["PASS", "FAIL", "NOT_CHECKED"] },
        "stale_execution_check": { "type": "string", "enum": ["PASS", "FAIL", "NOT_CHECKED"] },
        "temporal_receipt_ref": { "type": ["string", "null"] },
        "label": { "type": "string", "const": "EXTERNAL_SIGNAL_ONLY" }
      },
      "additionalProperties": false
    },
    "runtime_status": {
      "type": "string",
      "enum": [
        "SPEC_ONLY", "CONTRACT_SKELETON_ONLY", "CONTRACT_READY",
        "DRY_RUN_CANDIDATE", "DRY_RUN_ONLY", "FORBIDDEN_RUNTIME"
      ],
      "default": "CONTRACT_SKELETON_ONLY"
    }
  }
}
