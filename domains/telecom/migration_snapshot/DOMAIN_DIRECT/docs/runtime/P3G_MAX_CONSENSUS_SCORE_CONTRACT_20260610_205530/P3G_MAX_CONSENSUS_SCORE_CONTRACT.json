      "S2": "ATTENTION",
      "S3": "RISQUE ÉLEVÉ",
      "S4": "CRITIQUE",
      "S5": "MAXIMUM"
    },
    "technical_to_human": {
      "confidence_integrity": "intégrité",
      "confidence_governance": "contrôle X108",
      "confidence_readiness": "préparation",
      "harmonic_score": "confiance harmonique",
      "vote_count": "agents consultés",
      "agent_votes": "agents impliqués",
      "consensus_ratio": "niveau d'accord",
      "fail_closed": "sécurité par blocage",
      "hash": "empreinte",
      "merkle": "sceau Merkle",
      "trace_id": "trace vérifiable",
      "decision_id": "décision"
    }
  },
  "authority_boundary": {
    "kernel": "SOURCE_OF_TRUTH",
    "api": "BRIDGE_ONLY",
    "connectors": "DOMAIN_SENSOR_DISPLAY_ONLY",
    "sigma": "REPORT_ONLY_OR_VETO_ONLY_DEPENDING_LAYER",
    "human_terminal": "DISPLAY_ONLY",
    "no_display_field_may_authorize_action": true
  },
  "required_wiring_contract": {
    "must_not_change": [
      "aggregate4 threshold 3/4",
      "fail_closed BLOCK default",
      "BLOCK > HOLD > ACT",
      "KX108_ONLY authority",
      "API bridge-only",
      "connectors non-sovereign",
      "existing decision trace fields"
    ],
    "must_add_to_live_decision": [
      "raw_engine.consensus",
      "raw_engine.consensus.rule",
      "raw_engine.consensus.threshold",
      "raw_engine.consensus.supermajority",
      "raw_engine.consensus.votes",
      "raw_engine.consensus.consensus_ratio",
      "raw_engine.consensus.fail_closed",
      "raw_engine.consensus.final_decision"
    ],
    "must_not_invent": [
