{
  "contract_id": "P3G_MAX_CONSENSUS_SCORE_CONTRACT",
  "status": "SPEC_CONTRACT_NOT_WIRED",
  "created_for": "Obsidia/X108 live domain terminal and decision surface",
  "scope": {
    "runtime_patch": false,
    "kernel_patch": false,
    "api_patch": false,
    "freeze": false,
    "commit": false,
    "purpose": "Define the complete decision score, consensus, proof and human-readable surface before wiring."
  },
  "formal_consensus_layer": {
    "rule": "aggregate4",
    "threshold": "3/4",
    "voters": 4,
    "supermajority_min": 3,
    "allowed_decisions": [
      "ACT",
      "HOLD",
      "BLOCK"
    ],
    "fail_closed_default": "BLOCK",
    "priority_order": "BLOCK > HOLD > ACT",
    "proof_sources": [
      "proofs/lean/Obsidia/Consensus.lean",
      "tests/test_consensus_split.py",
      "tests/test_consensus_local.py",
      "tests/test_consensus_inprocess.py",
      "proofs/distributed/aggregator.py",
      "docs/core_import/P72_INVARIANT_GRAPH_FORMAL_PROOF_ALIGNMENT.json"
    ],
    "proof_claims": [
      "aggregate4_act",
      "aggregate4_fail_closed",
      "aggregate4_unanimous",
      "no_two_distinct_supermajorities_4",
      "THRESHOLD_CONSERVATION",
      "BLOCK_PRIORITY_OVER_HOLD_ALLOW"
    ]
  },
  "live_decision_score_layer": {
    "confidence_integrity": "EXPOSED_NOW",
    "confidence_governance": "EXPOSED_NOW",
    "confidence_readiness": "EXPOSED_NOW",
    "readiness_scope": "harmonic_integrity_governance",
    "raw_engine.vote_count": "EXPOSED_NOW",
    "raw_engine.agent_votes": "EXPOSED_AS_AGENT_NAMES_ONLY",
    "sigma_report": "EXPOSED_NOW",
    "sigma_step": "EXPOSED_NOW",
    "decision_id": "EXPOSED_NOW",
    "trace_id": "EXPOSED_NOW",
    "x108_gate": "EXPOSED_NOW",
    "reason_code": "EXPOSED_NOW",
    "severity": "EXPOSED_NOW"
  },
  "harmonic_score_layer": {
    "inputs": [
      "confidence_integrity",
      "confidence_governance",
      "confidence_readiness"
    ],
    "formula": "3 / ((1 / confidence_integrity) + (1 / confidence_governance) + (1 / confidence_readiness))",
    "status": "DERIVED_FROM_EXPOSED_FIELDS",
    "official_kernel_field": false,
    "display_allowed": true,
    "display_label": "confiance_harmonique",
    "must_label_as": "calculée depuis les 3 scores exposés"
  },
  "agent_consensus_layer": {
    "agent_count": "EXPOSED_NOW",
    "agent_names": "EXPOSED_NOW",
    "agent_votes_detailed": "NOT_EXPOSED_NOW",
    "agent_mean": "NOT_EXPOSED_NOW",
    "consensus_ratio": "NOT_EXPOSED_NOW",
    "consensus_threshold": "PROVEN_AS_3_4_BUT_NOT_EXPOSED_IN_LIVE_DECISION",
    "supermajority": "PROVEN_BUT_NOT_EXPOSED_IN_LIVE_DECISION",
    "final_score": "NOT_EXPOSED_NOW",
    "required_live_consensus_surface": {
      "raw_engine.consensus.rule": "aggregate4",
      "raw_engine.consensus.threshold": "3/4",
      "raw_engine.consensus.voters": 4,
      "raw_engine.consensus.supermajority_min": 3,
      "raw_engine.consensus.votes": "decision counts by ACT/HOLD/BLOCK",
      "raw_engine.consensus.consensus_ratio": "max_count / voters",
      "raw_engine.consensus.supermajority": "boolean",
      "raw_engine.consensus.fail_closed": "boolean",
      "raw_engine.consensus.final_decision": "ACT/HOLD/BLOCK",
      "raw_engine.consensus.reason": "human and machine reason"
    }
  },
  "domain_score_surfaces": {
    "trading": {
      "existing_metric_keys": [
        "metrics.buy_score",
        "metrics.sell_score",
        "metrics.hold_score"
      ],
      "human_object": "ordre marché / BTC-USDT",
      "human_block_reason_map": {
        "CONTRADICTION_THRESHOLD_REACHED": "signaux contradictoires",
        "UNKNOWNS_OR_CONFIDENCE_LOW": "données manquantes ou confiance insuffisante"
      }
    },
    "bank": {
      "existing_metric_keys": [
        "metrics.authorize_score",
        "metrics.analyze_score",
        "metrics.block_score"
      ],
      "human_object": "paiement / transaction",
      "human_allow_label": "autorisé / surveillé"
    },
    "gps_defense_aviation": {
      "existing_metric_keys": [
        "metrics.trajectory_valid_score",
        "metrics.recalc_score",
        "metrics.degraded_score",
        "metrics.abort_score",
        "metrics.truth_score",
        "metrics.sigma_score"
      ],
      "human_object": "trajectoire / vol",
      "human_allow_label": "trajectoire validée"
    }
  },
  "human_terminal_layer": {
    "decision_labels": {
      "BLOCK": "BLOQUÉ",
      "HOLD": "MIS EN ATTENTE",
      "ALLOW": "AUTORISÉ / SURVEILLÉ",
      "ACT": "ACTION AUTORISÉE"
    },
    "severity_labels": {
      "S0": "NORMAL",
