{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "obsidia_cost_receipt.schema.json",
  "title": "OIE CostReceipt V0.1",
  "description": "Obsidia Inference Economy — single cost measurement unit. Non-sovereign: never emits ACT, never mutates kernel.",
  "type": "object",
  "required": [
    "receipt_id",
    "timestamp",
    "layer",
    "route",
    "domain",
    "action_type",
    "elapsed_ms",
    "internal_units",
    "modules_activated",
    "modules_skipped",
    "obsidia_cost_eur_per_1m",
    "baseline_label",
    "baseline_cost_eur_per_1m",
    "savings_ratio",
    "avoided_cost_eur_per_1m",
    "kernel_status",
    "proof_or_replay_available",
    "readonly",
    "decision_authority",
    "emits_act",
    "kernel_mutation",
    "memory_write",
    "graphiti_write",
    "neo4j_write"
  ],
  "properties": {
    "receipt_id": { "type": "string", "format": "uuid" },
    "timestamp":  { "type": "string", "format": "date-time" },
    "layer":      { "type": "string" },
    "route":      { "type": "string" },
    "domain":     { "type": "string" },
    "action_type":{ "type": "string" },
    "elapsed_ms": { "type": "number", "minimum": 0 },
    "internal_units": { "type": "number", "minimum": 0 },
    "modules_activated": { "type": "array", "items": { "type": "string" } },
    "modules_skipped":   { "type": "array", "items": { "type": "string" } },
    "obsidia_cost_eur_per_1m":  { "type": "number", "exclusiveMinimum": 0 },
    "baseline_label":           { "type": "string", "enum": ["BT_ENERGY_LOW","BT_ENERGY_HEAVY","BT_API_SIMPLE","BT_API_NORMAL","BT_AGENTIC"] },
    "baseline_cost_eur_per_1m": { "type": "number", "exclusiveMinimum": 0 },
    "savings_ratio":            { "type": "number", "exclusiveMinimum": 0 },
    "avoided_cost_eur_per_1m":  { "type": "number" },
    "kernel_status":            { "type": "string" },
    "proof_or_replay_available":{ "type": "boolean" },
    "readonly":           { "type": "boolean", "const": true },
    "decision_authority": { "type": "string",  "const": "KX108_ONLY" },
    "emits_act":          { "type": "boolean", "const": false },
    "kernel_mutation":    { "type": "boolean", "const": false },
    "memory_write":       { "type": "boolean", "const": false },
    "graphiti_write":     { "type": "boolean", "const": false },
    "neo4j_write":        { "type": "boolean", "const": false },
    "domain_metrics": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "properties": {
            "domain_name":               { "type": "string" },
            "domain_action_type":        { "type": "string" },
            "domain_risk_level":         { "type": "string" },
            "domain_reversibility":      { "type": "string" },
            "domain_cost_eur_per_1m":    { "type": "number", "minimum": 0 },
            "domain_latency_ms":         { "type": "number", "minimum": 0 },
            "domain_internal_units":     { "type": "number", "minimum": 0 },
            "domain_tools_used":         { "type": "array", "items": { "type": "string" } },
            "domain_tools_skipped":      { "type": "array", "items": { "type": "string" } },
            "external_api_calls_avoided":      { "type": "integer", "minimum": 0 },
            "llm_calls_avoided":               { "type": "integer", "minimum": 0 },
            "human_review_avoided_estimate":   { "type": "number",  "minimum": 0 },
            "hold_count":          { "type": "integer", "minimum": 0 },
            "block_count":         { "type": "integer", "minimum": 0 },
            "act_count":           { "type": "integer", "const": 0 },
            "unknowns_count":      { "type": "integer", "minimum": 0 },
            "contradictions_count":{ "type": "integer", "minimum": 0 },
            "proof_available":     { "type": "boolean" },
            "replay_available":    { "type": "boolean" },
            "business_cost_avoided_label":        { "type": "string" },
            "business_cost_avoided_estimate_eur": { "type": "number" },
            "domain_savings_ratio":               { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        }
      ]
    }
  },
  "additionalProperties": false
}
