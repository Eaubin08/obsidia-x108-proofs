{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://obsidia.local/schemas/gps_physical_observation.schema.json",
  "title": "GPS Physical Observation Envelope",
  "type": "object",
  "required": [
    "observation_id",
    "source_type",
    "proof_level",
    "eligible_for_physical_claim",
    "capture_timestamp",
    "processing_timestamp",
    "input_hash",
    "processor_name",
    "processor_config_hash",
    "observables_hash",
    "observables",
    "limitations"
  ],
  "properties": {
    "observation_id": { "type": "string" },
    "source_type": { "type": "string" },
    "proof_level": {
      "type": "string",
      "enum": [
        "SYNTHETIC_TEST_ONLY",
        "STRUCTURED_STATE",
        "RECORDED_REAL_GNSS",
        "RECORDED_RF_ATTACK",
        "REAL_PASSIVE_GNSS",
        "HARDWARE_IN_THE_LOOP",
        "EXTERNAL_REPLICATION"
      ]
    },
    "eligible_for_physical_claim": { "type": "boolean" },
    "dataset_name": { "type": "string" },
    "dataset_version": { "type": "string" },
    "license": { "type": "string" },
    "official_url": { "type": "string" },
    "capture_timestamp": { "type": "string" },
    "processing_timestamp": { "type": "string" },
    "receiver": { "type": "object" },
    "constellation": { "type": "array", "items": { "type": "string" } },
    "satellites": { "type": "array", "items": { "type": "string" } },
    "observables": { "type": "object" },
    "truth_reference": { "type": "object" },
    "input_hash": { "type": "string" },
    "processor_name": { "type": "string" },
    "processor_version": { "type": "string" },
    "processor_config_hash": { "type": "string" },
    "observables_hash": { "type": "string" },
    "domain_state_hash": { "type": "string" },
    "parent_receipt_id": { "type": "string" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  }
}
