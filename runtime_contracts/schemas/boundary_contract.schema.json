{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "obsidia/runtime_contracts/boundary_contract.schema.json",
  "title": "BoundaryContract",
  "description": "Droits exacts d'un module Obsidia. Defaults les plus restrictifs. Boundary: PERIPHERY_NON_SOVEREIGN.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module_name", "module_type", "os_layer",
    "readonly", "advisory_only", "emits_act", "emits_verdict",
    "can_write_memory", "can_write_graph", "can_call_tools",
    "requires_x108", "authority", "allowed_outputs", "forbidden_outputs",
    "source_status", "claim_scope"
  ],
  "properties": {
    "module_name": { "type": "string" },
    "module_type": {
      "type": "string",
      "enum": [
        "KERNEL", "SIGMA", "GRAPHITI", "BRODY", "NPL", "ATLAS",
        "COGNITIVE", "EXTERNAL_SIGNALS", "BALANCE", "GENCOIN",
        "GPS", "AGENT", "LLM", "UNKNOWN"
      ]
    },
    "os_layer": {
      "type": "string",
      "enum": ["OS1", "OS2", "OS3", "OS4", "PERIPHERY", "KERNEL_LAYER"]
    },
    "readonly": { "type": "boolean", "default": true },
    "advisory_only": { "type": "boolean", "default": true },
    "emits_act": { "type": "boolean", "default": false },
    "emits_verdict": { "type": "boolean", "default": false },
    "can_write_memory": { "type": "boolean", "default": false },
    "can_write_graph": { "type": "boolean", "default": false },
    "can_call_tools": { "type": "boolean", "default": false },
    "requires_x108": { "type": "boolean", "default": true },
    "authority": { "type": "string", "enum": ["KX108_ONLY", "NONE"] },
    "allowed_outputs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Outputs autorisés explicitement."
    },
    "forbidden_outputs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Outputs interdits explicitement."
    },
    "source_status": {
      "type": "string",
      "enum": [
        "LEAN_PROVEN", "PYTHON_TESTED", "PYTHON_SPEC_NOT_LEAN_PROVEN",
        "DOC_ONLY", "FUTURE_FORMAL_TARGET", "SPEC_FUTURE",
        "SOURCE_PARTIAL", "COPIED_READONLY", "AUDITED_ONLY",
        "SPEC_IMPORTED", "SPEC_LOCKED", "SOURCE_ONLY", "UNKNOWN_SOURCE"
      ]
    },
    "claim_scope": {
      "type": "string",
      "enum": [
        "CLAIMABLE_FORMAL", "CLAIMABLE_ADVISORY",
        "CLAIMABLE_SPEC_ONLY", "CLAIM_FORBIDDEN", "FUTURE_FORMAL_TARGET_ONLY"
      ]
    }
  }
}
