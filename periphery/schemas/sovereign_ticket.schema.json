{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SovereignTicket",
  "description": "Authorizes controlled world access. No ticket = no world call. Dry-run only in V4.",
  "type": "object",
  "required": ["ticket_id", "action_id", "os3_ticket_id", "scope", "issued_at", "expires_at", "x108_gate", "autonomy_level", "dry_run_only", "hash"],
  "properties": {
    "ticket_id": {"type": "string"},
    "action_id": {"type": "string"},
    "os3_ticket_id": {"type": "string"},
    "scope": {"type": "string"},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "x108_gate": {"type": "string", "enum": ["ALLOW", "HOLD", "BLOCK"]},
    "autonomy_level": {"type": "integer", "minimum": 0, "maximum": 5},
    "dry_run_only": {"type": "boolean", "const": true},
    "world_call_class": {"type": "string"},
    "hash": {"type": "string"}
  },
  "additionalProperties": false
}
