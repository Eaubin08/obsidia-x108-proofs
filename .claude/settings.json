      "Bash(git diff --stat)",
      "Bash(git diff --check)",
      "Bash(git diff --name-only:*)",
      "Bash(git diff --cached:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(ls)",
      "Bash(ls -la)",
      "Bash(wc:*)",
