      "NotebookEdit",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git apply:*)",
      "Bash(git worktree:*)",
      "Bash(git config:*)",
      "Bash(git clean:*)",
      "Bash(rm:*)",
      "Bash(mv:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(rmdir:*)",
      "Bash(sed -i:*)",
      "Bash(tee:*)",
      "Bash(dd:*)",
      "Bash(truncate:*)",
      "Bash(chmod:*)",
      "Bash(chown:*)",
      "Bash(ln:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(npm install:*)",
      "Bash(npm update:*)",
      "Bash(npm audit fix:*)",
      "Bash(pip install:*)",
      "Bash(winget install:*)",
      "Bash(autoskills:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(secrets/**)",
      "Read(audit/local/**)",
      "Read(**/*.pem)",
      "Read(vendor/wheels/**)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(server.kernel.sealed.cjs)",
      "Edit(proofs/V18_*/**)",
      "Edit(proofs/lean/**)",
      "Edit(proofs/tla/**)",
      "Edit(formal/tla/**)",
      "Edit(proofs/merkle_root.json)",
      "Edit(proofs/merkle_seal.json)",
      "Edit(proofs/rfc3161_anchor.json)",
      "Edit(merkle_root.json)",
      "Edit(merkle_seal.json)",
      "Edit(RECUPE_SCORING/aggregation_stable.py)",
      "Edit(RECUPE_SCORING/contracts_stable.py)",
      "Edit(P1_FREEZE_NOTE.md)",
      "Edit(PUBLIC_STATUS.md)",
