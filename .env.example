# Obsidia X-108 — environment template
# Copy to .env and fill in values. Never commit .env.
# cp .env.example .env

# ── API ──────────────────────────────────────────────────────
APP_ENV=dev
OBSIDIA_API_HOST=127.0.0.1
OBSIDIA_API_PORT=8000
OBSIDIA_API_BASE=http://127.0.0.1:8000

# ── CORS (F76 — set before production deployment) ───────────
# Comma-separated allowed origins. Wildcard ["*"] is dev-only.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000

# ── Graphiti / Neo4j (optional — readonly probe only) ────────
# Leave empty for offline / local-index-only mode.
GRAPHITI_V20_HTTP_BASE=
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# ── Secrets intentionally empty. Do not commit real .env files. ──

# F76b auth/rate-limiting
OBSIDIA_AUTH_ENABLED=false
OBSIDIA_API_KEY=
OBSIDIA_RATE_LIMIT_ENABLED=false
RATE_LIMIT_RPM=60
